{
  "permissions": {
    "allow": [
      "Bash(npm run *)", "Bash(npx tsc *)", "Bash(npx wrangler d1 migrations apply * --env staging*)",
      "Bash(npx wrangler d1 execute * --env staging*)", "Bash(npx wrangler deploy --env staging*)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(npx vitest *)", "Bash(npx better-auth *)"
    ],
    "ask": ["Bash(git push *)", "Bash(* --env production*)"],
    "deny": ["Bash(rm -rf *)", "Read(./.env*)", "Read(./.dev.vars)"]
  },
  "defaultMode": "acceptEdits"
}
