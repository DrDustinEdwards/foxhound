# GENERATED by scripts/gen-headers.mjs from app/lib/http/header-set.ts, on every build.
# Static files are served without the Worker, so they carry the same set here.
# No Content-Security-Policy: Foxhound's pages carry a per-request one.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), cross-origin-isolated=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), screen-wake-lock=(), sync-xhr=(self), usb=(), web-share=(), xr-spatial-tracking=(), clipboard-read=(), gamepad=(), hid=(), idle-detection=(), interest-cohort=(), serial=(), unload=(), publickey-credentials-get=(self), clipboard-write=(self)
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-DNS-Prefetch-Control: off
  X-Frame-Options: deny
  X-Permitted-Cross-Domain-Policies: none
  tdm-reservation: 1

/*.html
  Content-Type: text/html; charset=utf-8

/*.css
  Content-Type: text/css; charset=utf-8

/*.js
  Content-Type: text/javascript; charset=utf-8

/*.mjs
  Content-Type: text/javascript; charset=utf-8

/*.txt
  Content-Type: text/plain; charset=utf-8

/*.xml
  Content-Type: application/xml; charset=utf-8

/*.svg
  Content-Type: image/svg+xml; charset=utf-8

/
  Content-Type: text/html; charset=utf-8

/*/
  Content-Type: text/html; charset=utf-8

/*.png
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/*.svg
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/*.css
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/*.js
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/*.woff2
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable
