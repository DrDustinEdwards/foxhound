{
  "name": "foxhound",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check-tokens": "node scripts/check-tokens.mjs",
    "gen:headers": "node scripts/gen-headers.mjs",
    "gen:recova-map": "vitest run test/redirect-map.test.ts --update",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "auth:generate": "better-auth generate --config app/lib/auth/generate.config.ts --output app/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "check-canon": "node scripts/check-canon.mjs",
    "check-gates": "node scripts/check-gates.mjs",
    "report:knip": "knip --no-exit-code",
    "report:duplication": "jscpd",
    "report:page-weight": "devkit-route-weight",
    "report:assertions": "node scripts/report-assertionless-tests.mjs",
    "report:bloat": "npm run report:knip && npm run report:duplication && npm run report:page-weight && npm run report:assertions",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run check-tokens && npm run check-gates"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.111.0",
    "@cloudflare/workers-oauth-provider": "1.1.0",
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.5.0",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.5.1",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.7.2",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.9.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@sentry/cloudflare": "10.66.0",
    "better-auth": "1.6.23",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.11.2",
    "drizzle-orm": "0.45.2",
    "enarratio": "0.3.1",
    "highlight.js": "11.11.1",
    "isbot": "5.2.0",
    "lucide-react": "1.25.0",
    "marked": "18.0.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.1",
    "sanitize-html": "2.17.6",
    "stripe": "22.3.1",
    "workers-og": "0.0.27"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@cloudflare/vite-plugin": "1.64.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.11.0",
    "@eslint/js": "9.39.5",
    "@fontsource/martian-mono": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "better-sqlite3": "12.11.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jose": "6.2.3",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.3.5",
    "vitest": "3.2.7",
    "wrangler": "4.151.3",
    "yaml": "2.9.1"
  }
}
