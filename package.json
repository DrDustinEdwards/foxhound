{
  "name": "foxhound",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "site-runtime-headers --site foxhound --out public/_headers --header \"tdm-reservation: 1\" && react-router build",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-tokens": "devkit-tokens",
    "gen:recova-map": "vitest run test/redirect-map.test.ts --update",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "auth:generate": "npx auth@1.7.17 generate --config app/lib/auth/generate.config.ts --output app/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "devkit-db-migrate foxhound",
    "check-gates": "devkit-gates --min 7",
    "check:bloat": "devkit-no-bloat",
    "check:console": "devkit-console",
    "check:conformance": "devkit-conformance",
    "check:migrations": "devkit-migrations drizzle/migrations --manifest drizzle/migrations-manifest.json --min 64",
    "check:page-weight": "devkit-route-weight",
    "check:session": "site-runtime-session-check app workers mcp",
    "report:mutation": "devkit-mutation-report --protected \"billing|billable|money|payment|charge|invoice|refund|credit|fee|stripe|webhook|dispute|auth|session|tenant|isolation|account-scope|cross-account|member|role|admin-route-guard|fix|bug|regression|seen red|plant\" --json reports/mutation/kill-matrix.json",
    "check:test-assertions": "devkit-test-assertions",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run check-tokens && npm run check:console && npm run check:migrations && npm run check:test-assertions && npm run check-gates"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.27",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.65.0",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.17.1",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.49.0",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.180.0",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "1.7.27",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.164.10",
    "drizzle-orm": "0.45.4",
    "enarratio": "0.17.2",
    "hast-util-to-mdast": "10.1.3",
    "hastscript": "9.0.3",
    "htmlparser2": "12.0.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-smartypants": "3.0.3",
    "sanitize-html": "2.18.2",
    "stripe": "23.1.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.59.4",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.12",
    "@react-router/dev": "8.5.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "better-sqlite3": "13.2.0",
    "drizzle-kit": "0.31.11",
    "knip": "6.45.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.164.0"
  }
}
