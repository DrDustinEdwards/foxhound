{
  "name": "foxhound",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check-tokens": "node scripts/check-tokens.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "auth:generate": "better-auth generate --config app/lib/auth/generate.config.ts --output app/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "check-canon": "node scripts/check-canon.mjs",
    "check-gates": "node scripts/check-gates.mjs",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run check-tokens && npm run check-gates"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@sentry/cloudflare": "^10.65.0",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "highlight.js": "^11.11.1",
    "isbot": "^5",
    "lucide-react": "^1.25.0",
    "marked": "^18.0.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.2.0",
    "sanitize-html": "^2.17.6",
    "stripe": "^22.3.1",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/vite-plugin": "1.44.0",
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "8.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.1",
    "better-sqlite3": "^12.11.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "8.1.4",
    "vitest": "^3.2.0",
    "wrangler": "4.110.0"
  }
}
