{
  "name": "foxhound",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "build:staging": "cross-env CLOUDFLARE_ENV=staging react-router build",
    "build:production": "cross-env CLOUDFLARE_ENV=production react-router build",
    "deploy:staging": "npm run build:staging && wrangler deploy --env staging",
    "deploy:production": "npm run build:production && wrangler deploy --env production",
    "cf-typegen": "wrangler types",
    "auth:generate": "better-auth generate --config app/lib/auth/generate.config.ts --output app/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate:staging": "wrangler d1 migrations apply foxhound-staging --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply foxhound-production --env production --remote"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.65.0",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.2.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/vite-plugin": "1.44.0",
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "8.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "8.1.4",
    "vitest": "^3.2.0",
    "wrangler": "4.110.0"
  }
}
