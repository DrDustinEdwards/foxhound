{
  "name": "foxhound",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "site-runtime-headers --site foxhound --out public/_headers --header \"tdm-reservation: 1\" && react-router build",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check-tokens": "node scripts/check-tokens.mjs",
    "gen:recova-map": "vitest run test/redirect-map.test.ts --update",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "auth:generate": "npx auth@1.7.12 generate --config app/lib/auth/generate.config.ts --output app/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "check-gates": "node scripts/check-gates.mjs",
    "check:bloat": "devkit-no-bloat",
    "check:console": "devkit-console",
    "check:conformance": "devkit-conformance",
    "check:migrations": "devkit-migrations drizzle/migrations --manifest drizzle/migrations-manifest.json --min 64",
    "check:page-weight": "devkit-route-weight",
    "report:mutation": "devkit-mutation-report --protected \"billing|billable|money|payment|charge|invoice|refund|credit|fee|stripe|webhook|dispute|auth|session|tenant|isolation|account-scope|cross-account|member|role|admin-route-guard|fix|bug|regression|seen red|plant\" --json reports/mutation/kill-matrix.json",
    "report:assertions": "node scripts/report-assertionless-tests.mjs",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run check-tokens && npm run check:console && npm run check:migrations && npm run check-gates"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.12",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.31.4",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.9.0",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.18.0",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.71.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@sentry/cloudflare": "10.66.0",
    "better-auth": "1.7.12",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.61.0",
    "drizzle-orm": "0.45.2",
    "enarratio": "0.6.0",
    "hast-util-to-string": "3.0.1",
    "isbot": "5.2.0",
    "lucide-react": "1.25.0",
    "parse5": "8.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.5.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-smartypants": "3.0.3",
    "sanitize-html": "2.17.6",
    "stripe": "23.0.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "workers-og": "0.0.27"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.20.23",
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/hast": "3.0.5",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "better-sqlite3": "12.11.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "knip": "6.41.0",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.3.5",
    "vitest": "3.2.7",
    "wrangler": "4.152.0"
  }
}
