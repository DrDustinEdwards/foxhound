{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foxhound",
  "main": "./workers/app.ts",
  // No newer than the workerd that @cloudflare/vite-plugin bundles supports, or `npm run dev` refuses to start.
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // The daily 03:00 run syncs every account's Intelligence in one invocation,
  // several Stripe calls per customer, with about fifteen other daily jobs.
  // The paid default of 10,000 subrequests per invocation runs out after a few
  // large merchants; Cloudflare allows up to 10 million (changelog 2026-02-11).
  "limits": {
    "subrequests": 1000000
  },
  "assets": {
    "directory": "./build/client"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },

  // WORKERS CACHE (345 binding 4, enabled session 53). Enabled only AFTER the
  // response policy in app/lib/http/cache-policy.ts shipped and was proven in
  // production, because two documented facts make a blind enable a data leak:
  //
  //   1. Bypass is triggered by Set-Cookie on the RESPONSE and Authorization on
  //      the REQUEST, and NOT by a request Cookie header. The marketing layout
  //      renders the signed-in account switcher on the same URLs anonymous
  //      visitors fetch, so without the policy a cached signed-in render of /
  //      would be served to a stranger.
  //   2. Responses with no Cache-Control are eligible for RFC 9111 heuristic
  //      freshness, so "we set no header" never meant "it will not be cached".
  //      Every response now leaves the fetch entry with an explicit directive.
  //
  // COST, accepted knowingly: with caching on, every request is billed at the
  // standard Workers request rate INCLUDING static asset requests, which are
  // normally free (developers.cloudflare.com/workers/cache/).
  //
  // cross_version_cache is left at its default of false, so the Worker version
  // is part of the cache key and every deploy resets the cache. That is what a
  // repo-authored site wants and it is why the marketing TTL can be 300s.
  //
  // ENABLED THE SECOND TIME UNDER 348, AFTER `Vary: Cookie`. The first enable
  // was reverted the same session because a signed-in request returned HIT: the
  // Cache-Control policy governs what is STORED, and the Worker does not run on
  // a hit, so nothing computed inside it can govern what is SERVED. Vary moves
  // that decision into the CACHE KEY, which is the only layer that runs on a
  // hit, so a request carrying a session cookie cannot match the variant stored
  // for a request carrying none. Do not enable this without that header.
  "cache": {
    "enabled": true
  },

  // Single environment. Worker "foxhound" at foxhoundapp.com (Phase 9 domain
  // cutover, TASK-foxhound-domain-cutover.md). workers_dev was left enabled
  // during the transition so foxhound.dustin-edwards.workers.dev kept serving
  // until the cutover was verified. This is the follow-up that config promised:
  // the cutover is verified by this repo's own standard, since the CI
  // deploy-consistency gate polls https://foxhoundapp.com directly, so the
  // second unauthenticated origin serving the same Worker, D1 and KV is closed.
  //
  // THE DATABASE IS NOW PLAINLY NAMED (301, 2026-08-15). The app binds
  // "foxhound", id 3ad240ed-de30-4684-a181-1da33ea08b65. The name finally
  // matches the thing: no label to read past, no inversion to remember.
  //
  // The lineage, because two moves in one day is easy to misread. For most of
  // the rebuild the binding was "foxhound-staging", id 4aa23f57, a dashboard
  // label only: that database WAS production. 299 ended that deferral by moving
  // to "foxhound-production", id 7469d599. 301 finished the job by moving to
  // "foxhound". There is no D1 rename API, so each step was a new database:
  // export, create, load in foreign-key order, count-walk parity, rebind,
  // deploy. 301 landed 54 of 55 tables at exact parity, the one difference being
  // sqlite_sequence, a SQLite internal.
  //
  // EVERY EARLIER DATABASE IS GONE, and who deleted each one is recorded because
  // the no-delete rule is about WHO may act, not about the fact of deletion.
  // 4aa23f57 was deleted by the SEAT under 302's quoted delegation; 7469d599 by
  // the seat under 303; the old empty foxhound-production ae406c63 was retired
  // by Dustin himself. Measured 2026-08-15: all three unreachable by id.
  //
  // The no-delete sentence 299 and 301 carried is DISCHARGED, not dropped. It
  // protected 7469d599 until 303 authorized its deletion, and it did its job:
  // no agent deleted anything without a quoted ruling naming the id.
  //
  // The KV is id 8ff187... and is now titled "foxhound" too (renamed 303), so
  // no "-staging" label survives anywhere. scripts/db-migrate.mjs still guards
  // the migration path, and every --remote command naming "foxhound" is a
  // production write.

  "workers_dev": false,
  "routes": [
    { "pattern": "foxhoundapp.com", "custom_domain": true },
    { "pattern": "www.foxhoundapp.com", "custom_domain": true }
  ],

  "vars": {
    // Canonical origin for Better Auth callbacks/redirects and the Stripe Connect
    // redirect URI. Non-secret.
    "BETTER_AUTH_URL": "https://foxhoundapp.com",
    // Turnstile site key (public, non-secret; safe to commit), widget
    // "Foxhound" on foxhoundapp.com. TURNSTILE_SECRET_KEY (env.d.ts, wrangler
    // secret) is the other half; the check runs only when both are set.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFsFHhwjNpVpV-tg"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foxhound",
      "database_id": "3ad240ed-de30-4684-a181-1da33ea08b65",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  // Nightly D1 dump bucket (job_f7f35d4b7ac7, bound under job_7bbec6ab48d1).
  // Bucket foxhound-backups was created on the account 2026-10-09. The d1-backup
  // cron job (app/lib/backup/d1-backup.ts) writes here and /health reads the
  // newest run from it; until this binding existed every nightly run threw.
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "foxhound-backups"
    },
    {
      // J07: merchant dispute evidence files (Recova's recova-dispute-evidence).
      // Bucket created by Dustin 2026-10-18.
      "binding": "EVIDENCE",
      "bucket_name": "foxhound-dispute-evidence"
    },
    {
      // The blog's media library: the pictures Carrel uploads for posts, served
      // publicly at /media/<key> (app/routes/files/media.ts), plus the earlier
      // bytes of each one under revisions/, which that route never serves. A
      // bucket of its own because neither one above may hold public files: the
      // backups are full D1 dumps and the evidence is merchants' private files.
      // THE BUCKET MUST EXIST BEFORE THIS DEPLOYS (a merge to main deploys).
      "binding": "MEDIA",
      "bucket_name": "foxhound-media"
    }
  ],
  // Cloudflare Images, through site-runtime ./image only: the blog's responsive
  // sizes (a closed width set, so every billed transform is one the page links),
  // and the turns, mirrors and shrinks an editor asks for in Carrel.
  "images": {
    "binding": "IMAGES"
  },
  // Workers AI, for the media library's suggested alt text and tags only
  // (app/lib/media/suggest.server.ts): run when an editor opens a picture's
  // suggestions in Carrel, on the blog pictures Carrel uploaded and nothing
  // else. No merchant data is ever sent.
  "ai": {
    "binding": "AI"
  },
  // NO KV BINDING, deliberately. The APP_KV binding was REMOVED 2026-08-15 by
  // ruling 310, after `env.APP_KV` measured ZERO consumers across app/ and
  // workers/: it was bound here and enumerated on the env-sanity surface while
  // nothing whatsoever read it, so that surface reported a binding no request
  // could ever exercise.
  //
  // THE NAMESPACE ITSELF IS NOT DELETED. KV id 8ff1871236394486bd5aac4b408a4253
  // (dashboard title "foxhound", renamed by ruling 303) stays, and rides the
  // cold-check deletion protocol 302 established for databases: no agent deletes
  // it under any framing without Dustin's explicit per-namespace authorization
  // AND a same-minute cold verification, both recorded. Unbinding is reversible
  // in one line; deleting the namespace is not.
  //
  // If a consumer ever appears, re-add the binding here rather than minting a new
  // namespace: the id above is the one 303 renamed.

  // Cloudflare Email Service send binding (TASK-foxhound-email-provisioning.md).
  // Three domains onboarded, Enabled + DNS Configured: foxhoundapp.com (apex),
  // send.foxhoundapp.com (EMAIL_SEND_DOMAIN, dunning), auth.foxhoundapp.com
  // (EMAIL_AUTH_DOMAIN, transactional auth). No destination_address or
  // allowed_destination_addresses: Foxhound sends dunning mail to arbitrary
  // merchant customers, so a destination allowlist would break the product.
  // allowed_sender_addresses IS set: every send this codebase issues
  // constructs its own `from` from one of exactly two fixed constants
  // (EMAIL_FROM_ADDRESS, EMAIL_AUTH_SENDER_ADDRESS), never a caller-supplied
  // address, so this closes off an entire class of misdirected sends (a bug,
  // or a future change that mistakenly threads an arbitrary address into
  // `from`) at the infrastructure level for zero operational cost today. Add
  // a third address here first if a third sender is ever introduced.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["recovery@send.foxhoundapp.com", "noreply@auth.foxhoundapp.com"]
    }
  ],

  // Email dispatch queue (TASK-foxhound-email-provisioning.md Phase 2). Queue
  // "foxhound-email" created via `wrangler queues create` (did not exist;
  // `wrangler queues list` confirmed); the queue name lives in EMAIL_QUEUE_NAME
  // (constants.ts) and is load-bearing in consumer.ts. dead_letter_queue is a
  // bare name, not a binding: Cloudflare auto-creates it on deploy if absent (no
  // `wrangler queues create` needed for it), and nothing reads from it yet.
  // The EMAIL_DLQ declaration this comment used to point at is DELETED
  // 2026-08-14 under 287/289: it was declared in env.d.ts and listed by
  // getEnvSanity while bound nowhere here, so the sanity surface reported a
  // binding that could never be set. The dead_letter_queue below is a bare
  // QUEUE NAME on the consumer, not a binding, and is unaffected. Without an
  // explicit DLQ, a
  // dunning email that keeps failing is discarded with no trace after
  // max_retries; max_retries here matches EMAIL_QUEUE_MAX_RETRIES exactly,
  // since that constant exists specifically to mirror this value.
  //
  // THE PRODUCER IS DELETED 2026-08-14 under ruling 280 as amended by 281a. The
  // EMAIL_QUEUE binding existed solely so `enqueueEmail` could call
  // env.EMAIL_QUEUE.send; that export had zero callers and zero producers into
  // this queue anywhere, re-measured at HEAD 937ac0c, so no code could reach the
  // binding and it goes with the export. THIS IS THE DEPLOY-AFFECTING PART: it
  // changes the Worker's declared bindings, so it proves through CI's deploy job
  // like a migration.
  //
  // THE CONSUMER DELIBERATELY STAYS. A queue with a consumer and no producer is
  // coherent; if an async send path is ever wanted, the producer is six lines
  // and one binding to restore.
  //
  // THE SENTENCE THAT USED TO END THIS PARAGRAPH WAS WRONG, and it is corrected
  // rather than deleted because it was load-bearing in a ruling. It read: "This
  // registration is what keeps that handler reachable, so dropping it would
  // manufacture the rebuild blocker 6 forbids." It pointed at the WRONG QUEUE.
  // consumer.ts dispatches on `batch.queue`, and the bounce-and-complaint arm
  // matches EMAIL_EVENTS_QUEUE_NAME, so the foxhound-email registration below
  // never made that arm reachable by anything. Registering one queue does not
  // reach a handler that branches on another. Found by 376 item (9) against a
  // live `wrangler queues list`, which also showed the events queue did not
  // exist on the account at all.
  "queues": {
    // THE MONTHLY AUDIT QUEUE (job_97878f0d1fde). The monthly-audit cron sends
    // one message per opted-in account through AUDIT_QUEUE and this Worker's own
    // queue() handler audits one account per invocation, so a large account
    // spends its Stripe pages in its own subrequest budget and cannot starve the
    // accounts after it. max_batch_size 1 is what makes it one account per
    // invocation; max_retries mirrors AUDIT_QUEUE_MAX_RETRIES; max_concurrency
    // keeps the Stripe and model calls from fanning out across every account at
    // once; retry_delay spreads the four deliveries over minutes, so a short
    // Stripe or model outage cannot use every attempt. No dead-letter queue: the audit_digest_runs row keeps the error and
    // the last attempt raises the monthly-audit failure alert.
    // The anonymous audit's delayed Stripe grant revoke rides this same queue,
    // sent with delaySeconds by /audit/callback (app/lib/audit/grant-revoke.server.ts).
    "producers": [
      {
        "queue": "foxhound-audit",
        "binding": "AUDIT_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "foxhound-audit",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 60,
        "max_concurrency": 5
      },
      {
        "queue": "foxhound-email",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "foxhound-email-dlq"
      },
      // THE DEAD-LETTER QUEUE NOW HAS A CONSUMER (313). It had ZERO until this,
      // measured against the account with `wrangler queues list`, which is what
      // made the comment below literally true: a dunning email that exhausted its
      // retries was discarded with no trace. The consumer routes to the SAME
      // worker; workers/app.ts branches on batch.queue and writes an
      // email_dead_letters row, then raises one alert per day.
      //
      // NO dead_letter_queue of its own, deliberately: a DLQ for the DLQ would
      // just move the same silent discard one hop further out. A message that
      // fails to be RECORDED is counted in the batch result instead.
      {
        "queue": "foxhound-email-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3
      },
      // THE BOUNCE AND COMPLAINT QUEUE (376 item (9), core.md blocker 6). The
      // queue was created on the account in the same session as this line
      // (`wrangler queues create foxhound-email-events`, id 4b5439fe...); it did
      // not exist before, so consumer.ts's second arm was unreachable twice
      // over: no registration and no queue.
      //
      // Retry posture matches foxhound-email. NO dead_letter_queue, and that is
      // where the consumer's own code overrode the "same posture" default: the
      // DLQ arm in workers/app.ts hands every message to recordDeadLetters,
      // which casts the body to EmailJob and builds an email dead-letter row.
      // An EmailServiceEvent is not that shape, so pointing this queue at
      // foxhound-email-dlq would file bounce events as malformed emails, and a
      // second DLQ nothing consumes would only move the discard one hop, which
      // is the reasoning already recorded above for the DLQ's own lack of one.
      // The residual is stated rather than hidden: an event that exhausts its
      // retries is dropped, and giving events their own recorder is a build,
      // not a config line.
      //
      // STILL MISSING AFTER THIS: the Email Sending event subscription, which
      // Dustin creates in the dashboard. Until it exists this queue has a
      // consumer and no producer, so the handler is reachable and nothing
      // reaches it. That is the last half of blocker 6.
      {
        "queue": "foxhound-email-events",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3
      }
    ]
  },

  "durable_objects": {
    "bindings": [
      {
        // Per-account money-write serializer (Phase 4a). SQLite-backed.
        "name": "MONEY_WRITER",
        "class_name": "MoneyWriteDurableObject"
      },
      {
        // Per-cron mutex (Phase 4e). Replaces the legacy hand-rolled cron_locks
        // table; addressed by idFromName(cronName).
        "name": "CRON_LOCK",
        "class_name": "CronLockDurableObject"
      },
      {
        // The five-minute ticker (app/lib/cron/ticker.ts): one instance whose
        // alarm runs the "*/5 * * * *" jobs every five minutes, because
        // Cloudflare stopped firing that trigger on 2026-10-23. Armed from
        // scheduled() and queue(), never from fetch().
        "name": "CRON_TICKER",
        "class_name": "CronTickerDurableObject"
      },
      {
        // The per-caller limiter of app/lib/http/rate-limit.ts, addressed by
        // idFromName(`${bucket}:${key}`). Its class is site-runtime's
        // RateLimiter under Foxhound's old class name (workers/app.ts), so the
        // namespace stays (RULES.md 3.13). Sign-in and signup use
        // AUTH_RATE_LIMITER below (J52).
        "name": "RATE_LIMITER",
        "class_name": "RateLimiterDurableObject"
      },
      {
        // The sign-in and signup limiter: site-runtime's RateLimiter class
        // (Q5, RULES.md 4.10), exported from workers/app.ts. One instance per
        // "auth:<ip>" or "signup:<ip>" (app/lib/auth/rate-limit.server.ts).
        "name": "AUTH_RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },

  // DO lifecycle: declarative exports, replacing the legacy migrations array
  // (which failed deploys with the wrangler 10074 migration-tag error after the
  // two-env to one-env consolidation; tag state on the Worker no longer matched
  // the config). Per Cloudflare docs, existing Workers move from migrations to
  // exports with no data migration: namespaces stay in place, only the config
  // shape changes, and there is no tag field to conflict. The original two
  // classes were created via new_sqlite_classes, hence storage sqlite; a
  // brand-new class (RateLimiterDurableObject) can be declared directly in
  // this map with storage sqlite too, no migrations step required. Future
  // lifecycle changes (delete, rename, transfer) happen by editing this map;
  // do not reintroduce a migrations array, the two are mutually exclusive.
  "exports": {
    "MoneyWriteDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "CronLockDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "CronTickerDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "RateLimiterDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "RateLimiter": { "type": "durable-object", "storage": "sqlite" }
  },

  // All scheduled jobs are Cron Triggers (ARCHITECTURE.md; no HTTP cron surface,
  // no CRON_SECRET). scheduled() dispatches by controller.cron to the registered
  // jobs (app/lib/cron/registry.ts); each is gated by cron_config + a per-cron DO
  // lock and logs to cron_run_history. These schedules MUST match the
  // CRON_SCHEDULE_* constants (every 5 min recovery tick, 0 3 * * * daily
  // retention, 0 4 1 * * monthly billing, 0 9 * * * expiring-card alerts).
  "triggers": {
    // "0 8 * * MON" is the weekly merchant digest at legacy's Monday 08:00 UTC.
    // Written as MON because Cloudflare numbers weekdays 1 = Sunday; the "1"
    // ported from Recova's Vercel cron ran it on Sundays until 2026-10-29. Every schedule in the cron
    // registry MUST appear here or the job never fires, and a test guards it.
    // "0 9 * * *" is the expiring-card alert at legacy's hour (parity gap 11).
    // "* * * * *" is scheduled blog publishing (site-api v0.10.0): the
    // blog-schedules job runs runSchedules, so a post Carrel scheduled goes
    // live within a minute of its time. The five-minute ticker runs it too, in
    // case this trigger stops firing as "*/5" did (~/lib/cron/ticker.ts).
    "crons": ["*/5 * * * *", "0 3 * * *", "0 4 1 * *", "0 8 * * MON", "0 9 1 * *", "0 9 * * *", "* * * * *"]
  }
}
