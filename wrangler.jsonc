{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foxhound",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client"
  },
  "observability": {
    "enabled": true
  },

  // Single environment. Worker "foxhound" at foxhound.dustin-edwards.workers.dev.
  // The D1 keeps its original name "foxhound-staging" (a dashboard label only;
  // renaming a D1 is not worth it) and the KV keeps id 8ff187... - bindings and
  // data are unchanged from the previous two-env setup.
  //
  // Filled in future phases per ARCHITECTURE.md:
  // "queues": { "producers": [...], "consumers": [...] }  -- email dispatch + event consumption (Phase 4c)
  // "send_email" / EMAIL binding                            -- Cloudflare Email Service (Phase 4c)

  "vars": {
    // Canonical origin for Better Auth callbacks/redirects and the Stripe Connect
    // redirect URI. Non-secret.
    "BETTER_AUTH_URL": "https://foxhound.dustin-edwards.workers.dev",
    // Turnstile site key (public, non-secret; safe to commit). Placeholder
    // until Dustin creates the real widget; TURNSTILE_SECRET_KEY (env.d.ts,
    // wrangler secret) is the Dustin-gated half that actually enables the
    // no-auth estimator's Turnstile gate (Phase 6 Pass 3).
    "TURNSTILE_SITE_KEY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foxhound-staging",
      "database_id": "4aa23f57-244e-4e24-850c-66486e7ba92d",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "kv_namespaces": [
    {
      // dashboard title: foxhound-app-kv-staging
      "binding": "APP_KV",
      "id": "8ff1871236394486bd5aac4b408a4253"
    }
  ],

  // Cloudflare Rate Limiting bindings (ARCHITECTURE.md: "Cloudflare rate
  // limiting binding, keyed on cf-connecting-ip"; audit finding M-1,
  // foxhound-audit-security.md: /api/auth/* was live-verified unthrottled,
  // 8 rapid sign-in POSTs all returned 401 with no 429). Enforced in
  // workers/app.ts fetch, BEFORE the request reaches the route handler
  // (app/lib/http/rate-limit.ts), so a throttled request never runs a
  // sign-in DB lookup or dispatches a password-reset/verification email.
  // Two budgets, since ARCHITECTURE.md names no specific numbers so this
  // follows TASK-foxhound-auth-rate-limit.md's stated fallback:
  //   RATE_LIMIT_AUTH: one shared per-IP budget across the whole /api/auth/*
  //     prefix (10 req/min) - credential stuffing + password-reset /
  //     verification-email bombing.
  //   RATE_LIMIT_PUBLIC: one shared per-IP budget across the other
  //     unauthenticated POST surfaces, /demos enter + /audit estimator
  //     (20 req/min).
  // The binding's simple algorithm counts per-edge-location, which is
  // accepted: the goal is blunting brute force/bombing, not a precise global
  // quota. namespace_id values are arbitrary, only need to be unique among
  // this Worker's bindings.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMIT_AUTH",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        "name": "RATE_LIMIT_PUBLIC",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        // Per-account money-write serializer (Phase 4a). SQLite-backed.
        "name": "MONEY_WRITER",
        "class_name": "MoneyWriteDurableObject"
      },
      {
        // Per-cron mutex (Phase 4e). Replaces the legacy hand-rolled cron_locks
        // table; addressed by idFromName(cronName).
        "name": "CRON_LOCK",
        "class_name": "CronLockDurableObject"
      }
    ]
  },

  // DO lifecycle: declarative exports, replacing the legacy migrations array
  // (which failed deploys with the wrangler 10074 migration-tag error after the
  // two-env to one-env consolidation; tag state on the Worker no longer matched
  // the config). Per Cloudflare docs, existing Workers move from migrations to
  // exports with no data migration: namespaces stay in place, only the config
  // shape changes, and there is no tag field to conflict. Both classes were
  // created via new_sqlite_classes, hence storage sqlite. Future lifecycle
  // changes (delete, rename, transfer) happen by editing this map; do not
  // reintroduce a migrations array, the two are mutually exclusive.
  "exports": {
    "MoneyWriteDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "CronLockDurableObject": { "type": "durable-object", "storage": "sqlite" }
  },

  // All scheduled jobs are Cron Triggers (ARCHITECTURE.md; no HTTP cron surface,
  // no CRON_SECRET). scheduled() dispatches by controller.cron to the registered
  // jobs (app/lib/cron/registry.ts); each is gated by cron_config + a per-cron DO
  // lock and logs to cron_run_history. These schedules MUST match the
  // CRON_SCHEDULE_* constants (every 5 min recovery tick, 0 3 * * * daily
  // retention, 0 4 1 * * monthly billing).
  "triggers": {
    "crons": ["*/5 * * * *", "0 3 * * *", "0 4 1 * *"]
  }
}
