{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foxhound",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client"
  },
  "observability": {
    "enabled": true
  },

  // Single environment. Worker "foxhound" at foxhound.dustin-edwards.workers.dev.
  // The D1 keeps its original name "foxhound-staging" (a dashboard label only;
  // renaming a D1 is not worth it) and the KV keeps id 8ff187... - bindings and
  // data are unchanged from the previous two-env setup.
  //
  // Filled in future phases per ARCHITECTURE.md:
  // "queues": { "producers": [...], "consumers": [...] }  -- email dispatch + event consumption (Phase 4c)
  // "send_email" / EMAIL binding                            -- Cloudflare Email Service (Phase 4c)

  "vars": {
    // Canonical origin for Better Auth callbacks/redirects and the Stripe Connect
    // redirect URI. Non-secret.
    "BETTER_AUTH_URL": "https://foxhound.dustin-edwards.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foxhound-staging",
      "database_id": "4aa23f57-244e-4e24-850c-66486e7ba92d",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "kv_namespaces": [
    {
      // dashboard title: foxhound-app-kv-staging
      "binding": "APP_KV",
      "id": "8ff1871236394486bd5aac4b408a4253"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        // Per-account money-write serializer (Phase 4a). SQLite-backed.
        "name": "MONEY_WRITER",
        "class_name": "MoneyWriteDurableObject"
      },
      {
        // Per-cron mutex (Phase 4e). Replaces the legacy hand-rolled cron_locks
        // table; addressed by idFromName(cronName).
        "name": "CRON_LOCK",
        "class_name": "CronLockDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MoneyWriteDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CronLockDurableObject"]
    }
  ]
}
